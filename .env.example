APP_ENV=local

DATABASE_URL=postgresql+asyncpg://thiepcuoi:thiepcuoi@localhost:5432/thiepcuoi
# Database riêng cho pytest (bị xoá dữ liệu mỗi lần chạy test)
TEST_DATABASE_URL=postgresql+asyncpg://thiepcuoi:thiepcuoi@localhost:5432/thiepcuoi_test

# Tạo bằng: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-env-at-least-32-characters-long
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Production: COOKIE_SECURE=true. Nếu FE và API khác site (vd. *.vercel.app) thì COOKIE_SAMESITE=none
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CORS_ORIGINS=http://localhost:3000

# Local: RustFS trong docker-compose. Production: Cloudflare R2
#   S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
#   S3_REGION=auto
#   MEDIA_PUBLIC_BASE_URL=https://media.<domain-cua-ban>
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=thiepcuoi
S3_SECRET_ACCESS_KEY=thiepcuoi-secret
S3_BUCKET=thiepcuoi-media
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/thiepcuoi-media

MAX_IMAGE_BYTES=15728640
MAX_AUDIO_BYTES=10485760
MAX_IMAGES_PER_INVITATION=200
MAX_AUDIO_PER_INVITATION=1
MAX_INVITATIONS_PER_USER=5

# Next.js route nhận yêu cầu revalidate (để trống nếu chưa làm FE)
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=
