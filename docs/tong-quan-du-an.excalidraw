   "link": null,
   "locked": false,
   "text": "Không lưu access token ở localStorage\nDùng lại refresh token cũ: trong 20 giây → 401 refresh_token_rotated;\nsau 20 giây → thu hồi mọi phiên của user (refresh_token_reused)",
   "fontSize": 15,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Không lưu access token ở localStorage\nDùng lại refresh token cũ: trong 20 giây → 401 refresh_token_rotated;\nsau 20 giây → thu hồi mọi phiên của user (refresh_token_reused)",
   "autoResize": true,
   "lineHeight": 1.25
  },
