   "updated": 1762473600000,
   "link": null,
   "locked": false,
   "text": "config.py: đọc .env, các giới hạn MAX_*\ndb.py: engine, session, Base, tên pk_/uq_/fk_/ck_/ix_\ntypes.py: kiểu chuẩn hóa (SingleLine, Email, Uuid…)\nschemas.py: StrictModel (strict, cấm trường lạ)\nerrors.py: AppError, định dạng lỗi chung\ndeps.py: DbSession, CurrentUser",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "config.py: đọc .env, các giới hạn MAX_*\ndb.py: engine, session, Base, tên pk_/uq_/fk_/ck_/ix_\ntypes.py: kiểu chuẩn hóa (SingleLine, Email, Uuid…)\nschemas.py: StrictModel (strict, cấm trường lạ)\nerrors.py: AppError, định dạng lỗi chung\ndeps.py: DbSession, CurrentUser",
   "autoResize": true,
   "lineHeight": 1.25
  },
