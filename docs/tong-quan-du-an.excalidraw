   "seed": 860331864,
   "version": 1,
   "versionNonce": 161104359,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1762473600000,
   "link": null,
   "locked": false,
   "text": "✔ Backend API: Python + FastAPI (thư mục app/)\n✔ Database PostgreSQL: 7 bảng, 1 migration (alembic/)\n✔ Đặc tả là nguồn chuẩn (docs/spec/01–07)\n✔ Tài liệu từng module (docs/modules/) + tiến độ\n✔ 753 test tự động (tests/), chạy với Postgres thật\n✘ Chưa có Frontend: Next.js nằm ngoài repo này",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "✔ Backend API: Python + FastAPI (thư mục app/)\n✔ Database PostgreSQL: 7 bảng, 1 migration (alembic/)\n✔ Đặc tả là nguồn chuẩn (docs/spec/01–07)\n✔ Tài liệu từng module (docs/modules/) + tiến độ\n✔ 753 test tự động (tests/), chạy với Postgres thật\n✘ Chưa có Frontend: Next.js nằm ngoài repo này",
   "autoResize": true,
   "lineHeight": 1.25
  },
