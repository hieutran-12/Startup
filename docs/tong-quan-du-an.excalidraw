   "text": "{\n  \"error\": {\n    \"code\": \"validation_error\",\n    \"message\": \"Dữ liệu không hợp lệ\",\n    \"details\": [{\n      \"field\": \"content.couple.groom.full_name\",\n      \"code\": \"required\",\n      \"message\": \"Không được để trống\"\n    }]\n  }\n}",
