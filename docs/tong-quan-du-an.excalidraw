   "updated": 1762473600000,
   "link": null,
   "locked": false,
   "text": "Sản phẩm là gì?",
   "fontSize": 22,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Sản phẩm là gì?",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "el00049fea38",
   "type": "text",
   "x": 72,
   "y": 506,
   "width": 414,
   "height": 140,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 2,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [
    "el0001c2b6fa"
   ],
   "frameId": null,
   "roundness": null,
   "seed": 523654495,
   "version": 1,
   "versionNonce": 2119280613,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1762473600000,
   "link": null,
   "locked": false,
   "text": "Dịch vụ làm thiệp cưới online.\nCặp đôi tạo thiệp trên web: chọn mẫu, nhập thông tin,\nthêm sự kiện, ảnh, nhạc nền rồi đăng lên một link riêng\n(vd. thiepcuoi.vn/nam-lan) để gửi cho khách.\n\nMột thiệp dùng chung cho cả nhà trai và nhà gái.\nMỗi bên có link riêng, chỉ hiện sự kiện của bên mình.",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Dịch vụ làm thiệp cưới online.\nCặp đôi tạo thiệp trên web: chọn mẫu, nhập thông tin,\nthêm sự kiện, ảnh, nhạc nền rồi đăng lên một link riêng\n(vd. thiepcuoi.vn/nam-lan) để gửi cho khách.\n\nMột thiệp dùng chung cho cả nhà trai và nhà gái.\nMỗi bên có link riêng, chỉ hiện sự kiện của bên mình.",
   "autoResize": true,
   "lineHeight": 1.25
  },
