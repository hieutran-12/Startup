   "isDeleted": false,
   "boundElements": [],
   "updated": 1762473600000,
   "link": null,
   "locked": false,
   "text": "Python 3.13 · FastAPI · Pydantic (kiểu chặt)\nSQLAlchemy 2.0 async · PostgreSQL 16 · Alembic (migration)\nLưu file: S3 API (RustFS khi chạy local, Cloudflare R2 khi production)\nCông cụ: uv (cài đặt, chạy) · pytest (test) · ruff (lint, format)",
   "fontSize": 16,
   "fontFamily": 2,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Python 3.13 · FastAPI · Pydantic (kiểu chặt)\nSQLAlchemy 2.0 async · PostgreSQL 16 · Alembic (migration)\nLưu file: S3 API (RustFS khi chạy local, Cloudflare R2 khi production)\nCông cụ: uv (cài đặt, chạy) · pytest (test) · ruff (lint, format)",
   "autoResize": true,
   "lineHeight": 1.25
  },
