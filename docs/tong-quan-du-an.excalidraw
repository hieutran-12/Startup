  {
   "id": "el0254999f03",
   "type": "text",
   "x": 2412,
   "y": 2897,
   "width": 484,
   "height": 320,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
