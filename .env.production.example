# App settings for the API on AWS EC2 (docker-compose.prod.yml). On EC2, in /opt/thiepcuoi:
#   production.env  copy of this file, filled in for production (database thiepcuoi, bucket thiepcuoi-media-prod)
#   staging.env     copy of this file, filled in for staging (database thiepcuoi_staging, bucket
#                   thiepcuoi-media-staging, CORS_ORIGINS=http://localhost:5173)
# Never commit the real files (chmod 600). Every line is sent into the API container (env_file),
# so only keep variables the app uses.
# Do not add APP_ENV, COOKIE_SECURE, S3_ENDPOINT_URL, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY,
# S3_REGION here: docker-compose.prod.yml sets them.
# Empty values are on purpose: deploy/deploy.sh refuses to deploy while a required one is empty.
#
# Image tags are NOT here: /opt/thiepcuoi/.env holds the compose variables, written by deploy.sh:
#   API_REPOSITORY=<account-id>.dkr.ecr.ap-southeast-2.amazonaws.com/thiepcuoi-api
#   API_IMAGE_BLUE=..., API_IMAGE_GREEN=..., API_IMAGE_STAGING=...   (API_REPOSITORY:<commit>)

# RDS PostgreSQL 16. Example:
# postgresql+asyncpg://thiepcuoi:<password>@<rds endpoint>:5432/thiepcuoi?ssl=require
# Password: letters and digits only (it sits inside a URL). Stored in SSM Parameter Store
# /thiepcuoi/prod/DB_PASSWORD. New one: openssl rand -hex 24
DATABASE_URL=

# Stored in SSM Parameter Store /thiepcuoi/prod/JWT_SECRET. New one: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Web domain(s), comma separated. Production: https://ketduyen.me; staging: http://localhost:5173
CORS_ORIGINS=
# Web (ketduyen.me) and API (api.ketduyen.me) share a root domain: lax.
# Only if they ever sit on different root domains: none (Safari then drops the cookie)
COOKIE_SAMESITE=lax

# Private S3 bucket in ap-southeast-2, no dots in the name
S3_BUCKET=
# CloudFront domain in front of the bucket. No bucket name at the end, no trailing slash.
# Example: https://d1234abcd.cloudfront.net
MEDIA_PUBLIC_BASE_URL=

MAX_IMAGE_BYTES=15728640
MAX_AUDIO_BYTES=10485760
MAX_IMAGES_PER_INVITATION=200
MAX_AUDIO_PER_INVITATION=1
MAX_INVITATIONS_PER_USER=5
MAX_EVENTS_PER_INVITATION=10

# Next.js route that receives revalidate requests. Empty for now: the web is a Vite SPA
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=
