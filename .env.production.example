# Production trên VPS (docker-compose.prod.yml). Trên VPS: cp .env.production.example .env
# Các biến APP_ENV, COOKIE_SECURE, DATABASE_URL, S3_ENDPOINT_URL, S3_REGION, S3_BUCKET,
# MEDIA_PUBLIC_BASE_URL do docker-compose.prod.yml tự đặt, không khai báo ở đây.

# Hai domain đã trỏ DNS (bản ghi A) về IP của VPS
API_DOMAIN=api.example.com
MEDIA_DOMAIN=media.example.com

# Chỉ gồm chữ và số (nằm trong DATABASE_URL). Tạo bằng: openssl rand -hex 24
POSTGRES_PASSWORD=

# Tạo bằng: openssl rand -base64 48
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Domain của Next.js, nhiều domain thì cách nhau bằng dấu phẩy
CORS_ORIGINS=https://example.com
# FE và API khác site (không chung domain gốc) thì đổi thành none
COOKIE_SAMESITE=lax

# Tài khoản của RustFS, tự đặt. Secret tạo bằng: openssl rand -hex 24
S3_ACCESS_KEY_ID=thiepcuoi
S3_SECRET_ACCESS_KEY=

MAX_IMAGE_BYTES=15728640
MAX_AUDIO_BYTES=10485760
MAX_IMAGES_PER_INVITATION=200
MAX_AUDIO_PER_INVITATION=1
MAX_INVITATIONS_PER_USER=5
MAX_EVENTS_PER_INVITATION=10

# Next.js route nhận yêu cầu revalidate (để trống nếu chưa làm FE)
FRONTEND_REVALIDATE_URL=
FRONTEND_REVALIDATE_SECRET=
